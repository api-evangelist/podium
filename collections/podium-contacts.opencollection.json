          "http": {
            "method": "POST",
            "url": "https://api.podium.com/v4/contacts/campaigns/opt_in",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Opt in a contact into receiving campaign messages.\n         Note: this endpoint requires your application to be whitelisted.\n          Please contact our support team to get your application whitelisted.\n\nRequired scope: write_contacts"
