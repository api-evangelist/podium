          "info": {
            "name": "List all contacts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.podium.com/v4/contacts",
            "params": [
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Retrieves the page of items that comes after the `cursor`."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Max number of items to return per request. Defaults to `10`."
              },
              {
                "name": "updated_at",
                "value": "",
                "type": "query",
                "description": "Filter contacts by updated_at. It will retrieve contacts updated after the provided date. Format: `YYYY-MM-DDTHH:MM:SSZ`"
              }
            ]
          },
          "docs": "List all contacts.\n\nRequired scope: `read_contacts`."
        },
        {
          "info": {
            "name": "Create a contact",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.podium.com/v4/contacts",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a contact. If a contact with the same phone number, email, or conversation uid is found it will update the contact.\n\nRequired scope: `write_contacts`.\n"
        },
        {
          "info": {
            "name": "Opt in a contact",
            "type": "http"
